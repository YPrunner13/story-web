# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (선택, 기본값: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 장면 이미지 생성 엔드포인트 (선택)
# 기본값은 키 없이 동작하는 Pollinations. 다른 제공자로 바꾸려면 lib/image.ts 참고.
# NEXT_PUBLIC_IMAGE_BASE=https://image.pollinations.ai/prompt

# 고품질 캐릭터 음성 (선택, ElevenLabs)
# 설정하면 스튜디오가 표현력 있는 AI 음성을 사용. 없으면 브라우저 음성으로 자동 폴백.
# ELEVENLABS_API_KEY=...
# 음성 라이브러리에서 voice id 선택 (https://elevenlabs.io/app/voice-library)
# ELEVENLABS_VOICE_ID=TxGEqnHWrfWFTfGW9XjX
# ELEVENLABS_MODEL=eleven_multilingual_v2
